{
  "name": "segwire",
  "version": "1.0.0",
  "description": "七段数码管乱序接线推断与歧义解释后端（TypeScript + Node.js + SQLite）",
  "private": true,
  "type": "commonjs",
  "bin": {
    "segwire": "dist/src/cli/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.json && node --test dist/test/solver.test.js dist/test/api.test.js",
    "start": "node dist/src/cli/index.js serve",
    "demo": "node dist/src/cli/index.js demo",
    "cli": "node dist/src/cli/index.js"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
